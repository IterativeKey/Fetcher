# Fetcher settings. Easiest: run ./setup.sh, which writes this file for you.
# Or copy it to .env and edit by hand.

# --- Secrets (required). Generate each with:  openssl rand -hex 16
ARIA2_RPC_SECRET=change-me
# The web UI asks for this once and remembers it in the browser.
FETCHER_API_TOKEN=

# --- Folders. Relative paths are relative to this folder.
# The only directory downloads can be written to. Keep this app and DATA_DIR
# OUTSIDE it, so nothing a download writes can change how Fetcher runs.
DOWNLOAD_DIR=./downloads
# Fetcher's own state: job history, engine session, connection log.
DATA_DIR=./data
#
# Examples:
#   QNAP:     DOWNLOAD_DIR=/share/CACHEDEV1_DATA/Fetcher   (the real path:
#             `readlink -f /share/<name>`; on some models the volume is
#             /share/CE_CACHEDEV1_DATA. Never a path that doesn't exist:
#             it would be created on /share's tiny RAM disk.)
#   Synology: DOWNLOAD_DIR=/volume1/downloads
#   Linux:    DOWNLOAD_DIR=/srv/downloads

# --- User/group (numeric) that downloads are written and deleted as. Must be
# able to write to DOWNLOAD_DIR; the folder's ownership is never changed.
# Find them with:  id <username>     (QNAP's "everyone" group is usually 100)
PUID=1000
PGID=1000

# --- Network
# Port for the web UI.
FETCHER_PORT=5142
# Listen only on this address (e.g. the machine's LAN IP). Default: all.
# FETCHER_BIND=192.168.1.10
# By default, links to private/LAN addresses are refused.
FETCHER_ALLOW_LAN=false
# A host you added stays reachable for this many days after its last use.
FETCHER_ALLOW_TTL_DAYS=7
# Connection log rotation: rotate at N MB, keep this many old files.
FETCHER_LOG_MAX_MB=10
FETCHER_LOG_BACKUPS=9

# --- Engine throughput (the UI can also change concurrency and speed limit).
# More connections per server is faster, but some servers answer 429 (too
# many requests) above ~8.
MAX_CONCURRENT_DOWNLOADS=5
MAX_CONNECTION_PER_SERVER=8
SPLIT=8
